{
  "name": "perpl-livedata-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST + WebSocket + SSE server for the Perpl dashboard, reading the perpl squid's Postgres schema",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/websocket": "^11.3.4",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
