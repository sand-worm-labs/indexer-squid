#!/usr/bin/env bash
# Copy the root .env and every squid's .env to the server (they are gitignored, so git never carries them).
#   ./push-env [user@host] [remote_dir]      defaults: root@69.164.244.245  ~/indexer-squid
# The repo must already be cloned on the server. Existing remote .env files are overwritten.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

HOST=${1:-root@69.164.244.245}
DIR=${2:-indexer-squid}

files=(.env)
for f in indexers/*/squid.yaml; do [ -f "$(dirname "$f")/.env" ] && files+=("$(dirname "$f")/.env"); done
[ -f .env ] || { echo "error: no ./.env" >&2; exit 1; }

echo "pushing to $HOST:$DIR"; printf '  %s\n' "${files[@]}"
ssh "$HOST" "test -d '$DIR'" || { echo "error: $DIR not found on $HOST (clone the repo there first)" >&2; exit 1; }
rsync -R --chmod=F600 "${files[@]}" "$HOST:$DIR/"
echo done
